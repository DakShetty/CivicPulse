# ==============================================================================
# CivicPulse Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local or AWS runtime.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Mode
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Server Port & Binding
PORT=5000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Database Selection
# Local development default: sqlite:///civicpulse.db
# AWS RDS MySQL format: mysql+pymysql://<user>:<password>@<rds-endpoint>:3306/civicpulse
DATABASE_URL=sqlite:///civicpulse.db

# Storage Driver: 'local' (filesystem in ./storage) or 's3'
STORAGE_DRIVER=local
AWS_REGION=us-east-1
S3_BUCKET_NAME=civicpulse-attachments-demo

# Asynchronous Queue Driver: 'local' (database queue table) or 'sqs'
QUEUE_DRIVER=local
SQS_QUEUE_URL=
SQS_DLQ_URL=

# Notification Driver: 'local' (in-app DB events) or 'sns'
NOTIFICATION_DRIVER=local
SNS_TOPIC_ARN=

# CloudWatch Logging Driver: 'local' (console/file) or 'cloudwatch'
LOGGING_DRIVER=local
CLOUDWATCH_LOG_GROUP=/civicpulse/app

# AWS Parameter Store (used in EC2 production mode)
USE_PARAMETER_STORE=false
SSM_PARAM_PREFIX=/civicpulse/prod/
