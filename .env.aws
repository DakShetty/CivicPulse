# ==============================================================================
# CivicPulse Deployed AWS Cloud Environment Configuration
# Deployed in Region: ap-south-1 | AWS Account: 572059939036
# ==============================================================================

FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=civicpulse-cloud-secret-key-2026-production

# Server & Network
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=*

# AWS VPC & EC2 Deployment
EC2_INSTANCE_ID=i-06f603203a0f700b3
EC2_PUBLIC_IP=52.66.187.196
VPC_ID=vpc-067cb2b150520ccc6
AWS_REGION=ap-south-1

# Amazon RDS for MySQL (Private Subnet, Ingress only from EC2)
RDS_ENDPOINT=civicpulse-demo-mysql.cliw0qmyeewp.ap-south-1.rds.amazonaws.com
DB_NAME=civicpulse
DB_USER=civicadmin
# Database password is encrypted in SSM Parameter Store: /civicpulse-demo/prod/DB_PASSWORD

# Amazon S3 Private Bucket (Block Public Access + SSE-AES256)
STORAGE_DRIVER=s3
S3_BUCKET_NAME=civicpulse-demo-storage-572059939036

# Amazon SQS Queue with Dead-Letter Queue (DLQ)
QUEUE_DRIVER=sqs
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/572059939036/civicpulse-demo-jobs-queue
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/572059939036/civicpulse-demo-jobs-dlq

# Amazon SNS Alerts Topic
NOTIFICATION_DRIVER=sns
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:572059939036:civicpulse-demo-alerts-topic

# Amazon CloudWatch Logs & CPU Alarm
LOGGING_DRIVER=cloudwatch
CLOUDWATCH_LOG_GROUP=/civicpulse/civicpulse-demo
CLOUDWATCH_ALARM_NAME=civicpulse-demo-ec2-high-cpu
